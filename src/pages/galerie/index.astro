---
import Base from '../../layouts/Base.astro';
import KategorieKacheln from '../../components/KategorieKacheln.astro';
---

<Base titel="Galerie">
  <section class="seitenkopf">
    <div class="inhalt">
      <span class="ueberzeile">Galerie</span>
      <h1>Werke</h1>
      <p class="einleitung">Lichtobjekte aus Metall, Glas und Spiegel, Tierfiguren aus altem Besteck und Plastiken aus Eisenschrott, Stein und Beton.</p>
    </div>
  </section>
  <section class="abschnitt" style="padding-top: 0">
    <div class="inhalt">
      <KategorieKacheln />
    </div>
  </section>
</Base>
