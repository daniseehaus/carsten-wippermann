---
import Base from '../layouts/Base.astro';
import { kontakt } from '../data/site';
---

<Base titel="Impressum">
  <section class="seitenkopf">
    <div class="inhalt schmal text">
      <h1>Impressum</h1>
      <h2>Angaben gemäß § 5 DDG</h2>
      <p>{kontakt.name}<br />{kontakt.strasse}<br />{kontakt.ort}</p>
      <h2>Kontakt</h2>
      <p>
        Telefon: {kontakt.telefon.map((t, i) => (<>{i > 0 && ', '}<a href={t.href}>{t.anzeige}</a></>))}<br />
        E-Mail: <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      </p>
      <h2>Verantwortlich für den Inhalt</h2>
      <p>{kontakt.name}, Anschrift wie oben.</p>
      <h2>Urheberrecht</h2>
      <p>Alle Werke und Fotos auf dieser Website sind urheberrechtlich geschützt. Eine Verwendung ist nur mit Zustimmung von {kontakt.name} erlaubt.</p>
    </div>
  </section>
</Base>

<style>
  .text {
    padding-bottom: clamp(56px, 9vw, 112px);
  }
  h2 {
    font-size: 1rem;
    margin-top: 2rem;
    color: var(--text-leise);
  }
</style>
