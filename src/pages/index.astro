---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import KategorieKacheln from '../components/KategorieKacheln.astro';
import { kontakt, slogan } from '../data/site';
import { url } from '../lib/url';
import ameisen from '../assets/seiten/ameisen.jpg';
---

<Base>
  <section class="held">
    <Image class="held-bild" src={ameisen} alt="Zwei Ameisen aus Besteck auf Holzstämmen" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" quality={80} />
    <div class="held-text inhalt">
      <span class="held-zeile">Metall · Glas · Licht · Kunst</span>
      <h1>Carsten Wippermann<br /><span class="leise">Objektemacher</span></h1>
      <p class="slogan">„{slogan}“</p>
    </div>
    <a class="weiter" href="#einstieg" aria-label="Weiter nach unten"></a>
  </section>

  <section id="einstieg" class="abschnitt">
    <div class="inhalt schmal einblenden">
      <blockquote class="zitat">
        „Lebendig werden seine Gestalten vor allem durch Licht, das von hinten durch die in Rohbleche eingesägten Linien hindurchscheint. Manchmal sind es auch farbig verglaste Fenster, die den Blick des Betrachters geradezu anziehen.“
        <footer>Meller Kreisblatt, 22.07.2020</footer>
      </blockquote>
    </div>
  </section>

  <section class="abschnitt">
    <div class="inhalt">
      <div class="kopfzeile einblenden">
        <div>
          <span class="ueberzeile">Galerie</span>
          <h2>Werke</h2>
        </div>
        <a class="knopf" href={url('/galerie')}>Alle Galerien</a>
      </div>
      <KategorieKacheln />
    </div>
  </section>


  <section class="abschnitt">
    <div class="inhalt schmal kontakt einblenden">
      <span class="ueberzeile">Kontakt</span>
      <h2>Arbeiten auch auf Anfrage.</h2>
      <p class="leise">Besichtigungen nach telefonischer Absprache.</p>
      <p>
        {kontakt.telefon.map((t, i) => (<>{i > 0 && ' · '}<a href={t.href}>{t.anzeige}</a></>))}
        <br />
        <a href={`mailto:${kontakt.email}`}>{kontakt.email}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .held {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .held :global(.held-bild) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.75) brightness(0.6) contrast(1.05);
    animation: heranfahren 14s ease-out both;
  }
  .held::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--grund) 2%, rgb(27 28 30 / 0.15) 55%, rgb(27 28 30 / 0.5));
  }
  .held-text {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: clamp(80px, 14vh, 140px);
    animation: auftauchen 1.2s 0.2s ease both;
  }
  .held-zeile {
    display: block;
    margin-bottom: 1.2rem;
    font-size: clamp(0.8rem, 1.4vw, 0.95rem);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #fff;
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.7);
  }
  .held-zeile::before {
    content: '';
    display: inline-block;
    width: 32px;
    height: 1px;
    margin-right: 14px;
    vertical-align: middle;
    background: var(--akzent);
  }
  .held h1,
  .slogan {
    text-shadow: 0 1px 16px rgb(0 0 0 / 0.6);
  }
  .held h1 {
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    margin-bottom: 1.2rem;
  }
  .slogan {
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    max-width: 40ch;
    color: var(--text);
    opacity: 0.85;
  }
  .weiter {
    position: absolute;
    z-index: 1;
    left: 50%;
    bottom: 28px;
    width: 1px;
    height: 48px;
    background: linear-gradient(var(--akzent), transparent);
    animation: puls 2.4s ease-in-out infinite;
  }
  @keyframes heranfahren {
    from { transform: scale(1.08); }
    to { transform: scale(1); }
  }
  @keyframes auftauchen {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes puls {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .held :global(.held-bild), .held-text, .weiter { animation: none; }
  }

  .kopfzeile {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: clamp(24px, 4vw, 44px);
  }
  .kopfzeile h2 {
    margin: 0;
  }

  @media (max-width: 760px) {
    .kopfzeile .knopf {
      display: none;
    }
  }

  .kontakt {
    text-align: center;
  }
</style>
